# ==============================================================================
# AquaGuard AI - Environment Variables Template (.env.example)
# AI-Based Plastic Waste Detection in Water Bodies Using Computer Vision
# Copy this file to '.env' and fill in the values. Do not commit '.env' to git.
# ==============================================================================

# --- FastAPI Backend Configuration ---
API_ENV=development # development, testing, production
API_HOST=0.0.0.0
API_PORT=8000
API_SECRET_KEY=your-super-secret-key-change-in-production
API_CORS_ORIGINS=["http://localhost:3000"]

# --- PostgreSQL Database Configuration ---
POSTGRES_USER=your_db_user
POSTGRES_PASSWORD=your_db_password
POSTGRES_DB=aquaguard_db
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
DATABASE_URL=postgresql://your_db_user:your_db_password@localhost:5432/aquaguard_db

# --- ML Pipeline & Inference Configuration ---
MODEL_DIR=./models
DEFAULT_CONFIDENCE_THRESHOLD=0.5
DEVICE=cpu # cpu, cuda, mps

# --- ML Experiment Tracking (MLflow Example) ---
MLFLOW_TRACKING_URI=http://localhost:5000
MLFLOW_EXPERIMENT_NAME=aquaguard-waste-detection

# --- Weights & Biases (Alternative Tracking) ---
WANDB_API_KEY=your-wandb-api-key-if-used
WANDB_PROJECT=aquaguard-ai

# --- Docker Configuration ---
DOCKER_PORT=8000
DOCKER_DB_PORT=5432
